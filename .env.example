# Copia questo file in .env:  cp .env.example .env
# Tutti i valori sono opzionali tranne quelli del database, che hanno default adatti al solo uso locale.

# Porta locale dell'app (pubblicata solo su 127.0.0.1)
APP_PORT=8080

# ── Database (non esposto sull'host) ────────────────────────────────────────────
# Evita caratteri speciali (@ : / ? #) nella password: finisce in un URL di connessione.
POSTGRES_USER=jobagg
POSTGRES_PASSWORD=jobagg_local_only
POSTGRES_DB=jobagg

# ── Notifiche Telegram (opzionali) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Import alert via email (opzionale, fonte "email_alerts") ───────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# etichetta/cartella dedicata agli alert
IMAP_MAILBOX=job-alerts

# ── Candidature da Gmail (opzionale; si collega da Profilo → Fonti) ─────────────
# Client OAuth di tipo "App desktop" creato su Google Cloud, con la Gmail API attiva (vedi docs/GUIDA.md).
# L'app chiede solo la lettura della posta; il token ottenuto resta in un volume Docker, non nel database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM (disattivato di default; si abilita dalla sezione Profilo → Avanzate) ───
# Se valorizzato (ollama | anthropic | openai) forza il provider scelto nelle impostazioni.
LLM_PROVIDER=
# Necessarie solo per i provider esterni. Annunci e CV verranno inviati a terzi: la UI chiede il consenso.
# Provider "anthropic" (Claude Agent SDK): basta una delle due. Se ci sono entrambe vale il token.
#   ANTHROPIC_API_KEY        chiave della Claude Console
#   CLAUDE_CODE_OAUTH_TOKEN  token a lunga durata del tuo abbonamento Claude, generato con `claude setup-token`
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=

# ── Colloqui simulati: risposte a voce (opzionale) ──────────────────────────────
# La trascrizione gira in locale nel container "whisper" (profilo stt). Per avviarlo sempre insieme all'app:
# COMPOSE_PROFILES=stt
# Modello Whisper: tiny | base | small | medium (più grande = più preciso e più lento; small va bene su CPU)
WHISPER_MODEL=small

# ── Colloqui simulati: voce dell'intervistatore (opzionale) ─────────────────────
# Voce neurale locale nel container "piper" (profilo tts); senza, parla la sintesi vocale del browser.
# Per avviarlo sempre insieme all'app: COMPOSE_PROFILES=stt,tts
# Una voce per lingua, separate da virgola (elenco: https://huggingface.co/rhasspy/piper-voices)
PIPER_VOICES=it_IT-paola-medium,en_US-lessac-medium,fr_FR-siwis-medium

# ── Sviluppo ────────────────────────────────────────────────────────────────────
# Decommenta per caricare sempre anche il compose di sviluppo (hot reload):
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
